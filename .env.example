# Metropolitan Holdings — Accounting Coordinator Screening App
# Copy this file to .env and fill in your values

# ── Email (Results Delivery) ──────────────────────────────────────────────
# The email address that receives all candidate results
HIRING_EMAIL=hiring@metropolitanholdings.com

# SMTP settings for sending email
# For Gmail: use App Password (not your regular password)
# Generate at: myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here

# ── Claude AI Grading ─────────────────────────────────────────────────────
# Get your key at: console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
